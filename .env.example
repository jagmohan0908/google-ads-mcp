# Hosted MCP mode
MCP_HOSTED_MODE=true

# Optional: requests per minute for each caller+label pair
MCP_RATE_LIMIT_PER_MIN=60

# ==============================
# CHANGE THESE VALUES ONLY
# ==============================
# 1) Replace YOUR_STRONG_TOKEN with any long secret string.
# 2) Keep caller_id as "name1" (or change consistently everywhere).
MCP_AUTH_TOKENS_JSON={"name1":"YOUR_STRONG_TOKEN"}

# RBAC mapping: which labels each caller can access.
# In this setup, name1 can access the single label Sriaas_ads.
MCP_LABEL_RBAC_JSON={"name1":["Sriaas_ads"]}

# Label config registry (single label -> single Google Ads credential bundle)
# Keep real secrets server-side only. Do NOT send client_secret from IDE.
#
# Replace these placeholders:
# - REPLACE_CUSTOMER_ID: target Google Ads customer id (digits only)
# - REPLACE_CLIENT_ID: OAuth client id
# - REPLACE_CLIENT_SECRET: OAuth client secret
# - REPLACE_REFRESH_TOKEN: OAuth refresh token
# - REPLACE_DEVELOPER_TOKEN: Google Ads developer token
# - REPLACE_LOGIN_CUSTOMER_ID: MCC login customer id (digits only)
MCP_LABEL_CONFIG_JSON={"Sriaas_ads":{"provider":"google_ads","allowedTools":["ads_query_report"],"accountContext":{"customer_id":"REPLACE_CUSTOMER_ID"},"credentials":{"client_id":"REPLACE_CLIENT_ID","client_secret":"REPLACE_CLIENT_SECRET","refresh_token":"REPLACE_REFRESH_TOKEN","developer_token":"REPLACE_DEVELOPER_TOKEN","login_customer_id":"REPLACE_LOGIN_CUSTOMER_ID","version":"v1"}}}

# Optional defaults for easier local testing in MCP clients.
# If set, you can omit these values in some tool calls.
MCP_DEFAULT_CALLER_ID=name1
MCP_DEFAULT_AUTH_TOKEN=YOUR_STRONG_TOKEN
MCP_DEFAULT_LABEL=Sriaas_ads

# Optional FastMCP auth/base URL settings (use if needed in your deployment)
# FASTMCP_SERVER_BASE_URL=https://your-domain.com
# FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_ID=
# FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_SECRET=
