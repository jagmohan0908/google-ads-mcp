# Hosted MCP mode
MCP_HOSTED_MODE=true

# Optional: requests per minute for each caller+label pair
MCP_RATE_LIMIT_PER_MIN=60

# Caller auth tokens (what Antigravity caller sends as auth_token)
# Key = caller_id, Value = shared token
MCP_AUTH_TOKENS_JSON={"name1":"A7#kP9!zQ2@LmX"}

# RBAC mapping: which labels each caller can access.
# In this setup, name1 can access the single label Sriaas_ads.
MCP_LABEL_RBAC_JSON={"name1":["Sriaas_ads"]}

# Label config registry (single label -> single Google Ads credential bundle)
# Keep real secrets server-side only. Do NOT send client_secret from IDE.
MCP_LABEL_CONFIG_JSON={"Sriaas_ads":{"provider":"google_ads","allowedTools":["ads_query_report"],"accountContext":{"customer_id":"1234567890"},"credentials":{"client_id":"replace.apps.googleusercontent.com","client_secret":"replace","refresh_token":"replace","developer_token":"replace","login_customer_id":"0987654321","version":"v1"}}}

# Optional FastMCP auth/base URL settings (use if needed in your deployment)
# FASTMCP_SERVER_BASE_URL=https://your-domain.com
# FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_ID=
# FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_SECRET=
